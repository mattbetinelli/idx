# IdeaXchange Platform - Production Deployment

This file contains environment variables for production deployment.
Replace the placeholder values with your actual production values.

# MongoDB Configuration
MONGO_USERNAME=ideaxchange_admin
MONGO_PASSWORD=strong_password_here

# JWT Configuration
JWT_SECRET=your_strong_jwt_secret_key_here

# Domain Configuration
FRONTEND_URL=https://ideaxchange.com
API_DOMAIN=api.ideaxchange.com

# Email Configuration (if implemented)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@ideaxchange.com
EMAIL_PASSWORD=email_password_here

# Other Configuration
NODE_ENV=production
